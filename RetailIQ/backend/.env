# DATABASE_URL intentionally omitted: the code default in app/config.py
# resolves to an absolute path (backend/retailiq.db) that works regardless
# of the process's working directory. Uncomment to override, e.g. for Postgres:
# DATABASE_URL=postgresql+psycopg2://retailiq:retailiq@localhost:5432/retailiq
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
