# Copy this file to backend/.env and adjust as needed.

# Optional: if omitted, defaults to an absolute path at backend/retailiq.db
# (SQLite, zero setup). For production/parity testing, point this at
# PostgreSQL instead, e.g.:
# DATABASE_URL=postgresql+psycopg2://retailiq:retailiq@localhost:5432/retailiq

JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:5173
